# Base Postgres (Neon, Supabase u otra). Sin esta variable, en local se usa una base embebida en .data/
DATABASE_URL=
# Contraseña para entrar al tablero desplegado
APP_PASSWORD=
# Cadena aleatoria larga para firmar la sesión
SESSION_SECRET=
# Token largo y aleatorio que va en la URL del conector MCP: /api/k/<MCP_TOKEN>/mcp
MCP_TOKEN=
